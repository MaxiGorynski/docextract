# ==============================================================================
# FILE: .gitignore
# LOCATION: /docextract/.gitignore (project root)
# ==============================================================================
#
# PURPOSE:
#   Git ignore rules for DocExtract project. Excludes sensitive files,
#   build artifacts, and environment-specific configurations.
#
# SECTIONS:
#   - Python / Django
#   - Node.js / Frontend
#   - Docker
#   - IDE / Editors
#   - Environment & Secrets
#   - Backups & Logs
#   - OS Files
#
# ==============================================================================

# =============================================================================
# Python / Django
# =============================================================================

# Byte-compiled / optimised / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
pytest_cache/

# Translations
*.mo
*.pot

# Django stuff
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Static files (collected)
staticfiles/
static_collected/

# Media files (user uploads)
media/

# Celery
celerybeat-schedule
celerybeat.pid

# =============================================================================
# Node.js / Frontend
# =============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
frontend/dist/
frontend/build/
.next/
out/

# Testing
coverage/

# Cache
.npm
.eslintcache
.stylelintcache
*.tsbuildinfo

# Runtime
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# =============================================================================
# Docker
# =============================================================================

# Docker override (local customisations)
docker-compose.override.yml

# =============================================================================
# IDE / Editors
# =============================================================================

# VSCode
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# PyCharm / IntelliJ
.idea/
*.iml
*.ipr
*.iws

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# Sublime Text
*.sublime-workspace
*.sublime-project

# =============================================================================
# Environment & Secrets
# =============================================================================

# Environment files (contain secrets)
.env
.env.local
.env.*.local
.env.production
.env.staging

# Keep example files
!.env.example
!.env.production.example

# SSL certificates (local copies)
certbot/conf/
certbot/www/
*.pem
*.key
*.crt
*.csr

# AWS credentials
.aws/

# =============================================================================
# Backups & Logs
# =============================================================================

# Backup files
backups/
*.sql
*.sql.gz
*.dump
*.bak
*.backup

# Log files
logs/
*.log
log/

# =============================================================================
# OS Files
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# =============================================================================
# Temporary Files
# =============================================================================

# Temporary files
tmp/
temp/
*.tmp
*.temp
*.bak
*.swp

# =============================================================================
# Project Specific
# =============================================================================

# Test uploads (development)
test_documents/
test_files/

# Local scripts (personal shortcuts)
local_*.sh
my_*.sh

# Profiling
*.prof