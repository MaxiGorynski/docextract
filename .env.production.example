# ==============================================================================
# FILE: .env.production.example
# LOCATION: /docextract/.env.production.example (project root)
# ==============================================================================
#
# PURPOSE:
#   Template for production environment variables. Copy to .env and fill in
#   actual values before deployment.
#
# USAGE:
#   cp .env.production.example .env
#   nano .env  # Edit with actual values
#
# SECURITY:
#   - NEVER commit .env to version control
#   - Use strong, unique passwords for all services
#   - Rotate SECRET_KEY if compromised
#   - Restrict ALLOWED_HOSTS to actual domains only
#
# GENERATING SECRETS:
#   Django SECRET_KEY:
#       python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
#   Random password:
#       openssl rand -base64 32
#
# ==============================================================================

# =============================================================================
# Django Core Settings
# =============================================================================

# Secret key for cryptographic signing (REQUIRED)
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-this-in-production

# Debug mode (MUST be False in production)
DEBUG=False

# Allowed hostnames (comma-separated, no spaces)
# Example: docextract.example.com,www.docextract.example.com
ALLOWED_HOSTS=docextract.example.com

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL database name
POSTGRES_DB=docextract

# PostgreSQL username
POSTGRES_USER=docextract

# PostgreSQL password (REQUIRED - use strong password)
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change-this-to-a-secure-password

# Database host (use 'db' for Docker network, or external hostname)
POSTGRES_HOST=db

# Database port (default: 5432)
POSTGRES_PORT=5432

# Full database URL (constructed from above, used by some libraries)
# DATABASE_URL=postgres://docextract:your-password@db:5432/docextract

# =============================================================================
# Redis Configuration
# =============================================================================

# Redis URL for Celery broker and Django cache
# Use 'redis' as hostname when running in Docker network
REDIS_URL=redis://redis:6379/0

# =============================================================================
# OpenAI Configuration
# =============================================================================

# OpenAI API key for AI-powered document extraction
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# =============================================================================
# Security Settings
# =============================================================================

# CSRF trusted origins (comma-separated, include https://)
# Must match your actual domain(s)
CSRF_TRUSTED_ORIGINS=https://docextract.example.com

# CORS allowed origins (comma-separated, include https://)
# Only needed if frontend is on different domain
CORS_ALLOWED_ORIGINS=https://docextract.example.com

# =============================================================================
# SSL/HTTPS Settings
# =============================================================================
# These are handled in Django settings when HTTPS is enabled

# Redirect all HTTP to HTTPS (enable after SSL setup)
# SECURE_SSL_REDIRECT=True

# Secure cookies (enable after SSL setup)
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# =============================================================================
# Feature Flags
# =============================================================================

# Enable AI-powered extraction (disable to use mock extraction)
AI_EXTRACTION_ENABLED=True

# =============================================================================
# Optional: Error Tracking
# =============================================================================

# Sentry DSN for error tracking (optional but recommended)
# Get from: https://sentry.io/
# SENTRY_DSN=https://your-sentry-dsn-here

# =============================================================================
# Optional: Email Configuration
# =============================================================================
# Uncomment and configure if email notifications are needed

# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-email-password
# DEFAULT_FROM_EMAIL=noreply@docextract.example.com

# =============================================================================
# Optional: File Storage
# =============================================================================
# Uncomment for S3-compatible storage (AWS S3, DigitalOcean Spaces, etc.)

# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_STORAGE_BUCKET_NAME=docextract-media
# AWS_S3_REGION_NAME=eu-central-1
# AWS_S3_CUSTOM_DOMAIN=your-bucket.s3.amazonaws.com
